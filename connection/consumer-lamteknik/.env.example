# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_CONNECT_URL=http://localhost:8083
# One group per blockchain target. The Portainer stack sets this per service.
KAFKA_GROUP_ID=lamteknik-cdc-besu
TOPIC_PREFIX=lamteknik

# Source DB — change CDC_DB_TYPE to switch connector class
CDC_DB_TYPE=mysql
DB_HOST=127.0.0.1
# VM .41 host mapping for lamteknik-webapp-mysql (container port is 3306).
DB_PORT=3307
DB_USER=cdc_user
DB_PASSWORD=cdc_pass
DB_NAME=lamtek_db
TARGET_TABLES=akreditasi

# Consumer → blockchain API
# The gateway is the only transaction signer. Do not configure a private key here.
GATEWAY_ROOT=http://10.9.23.40:4100
BLOCKCHAIN_TARGET=besu
# Gateway auth, if enabled on .40.
API_KEY=

# Consumer → IPFS (for file/binary columns)
IPFS_CLUSTER_REST_URL=http://127.0.0.1:9094
CDC_FILE_COLUMNS=dokumen,attachment,*_blob,*_file

# Record mapping
CDC_PRIMARY_KEY=id
CDC_WRITE_DELETES=false

# Duplicate protection (offsets are committed only after target confirmation)
DEDUP_WINDOW_MS=10000
SKIP_BLOCKCHAIN_CHECK=false
