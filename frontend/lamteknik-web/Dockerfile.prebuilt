# Runtime-only image: reuses a .next produced by `npm run build` on the host.
# Avoids running `next build` inside Docker (which wedges on this machine's
# Docker/VM). Build the .next first on the host:
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1 npm run build
# then: docker build -f Dockerfile.prebuilt -t blockchain_lamtek-frontend .
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache curl

COPY package*.json ./
RUN npm ci --only=production

# Pre-built output from the host
COPY .next ./.next
COPY public ./public
COPY next.config.js ./

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD curl -f http://localhost:3002/ || exit 1

CMD ["npm", "run", "start"]
