# ============================================================
# SERVICE 4 — FRONTEND (Next.js)
# Build context: ./frontend   |   Listens on :3002
# ============================================================
#
# >>> CRITICAL: every NEXT_PUBLIC_* is inlined at BUILD time <<<
# They are NOT read at runtime. On Docker Swarm/PaaS you MUST pass them as
# build args (see frontend-stack.yml -> build.args). Changing them later means
# REBUILDING the image, not just restarting the container.

# Browser-facing backend API base URL. MUST include the /api/v1 prefix and MUST
# be the PUBLIC backend hostname (the browser resolves this, not the container).
NEXT_PUBLIC_API_URL=http://backend_lamtek.paas.hcm-lab.id/api/v1

# Public IPFS gateway the browser uses to open documents (no trailing slash).
NEXT_PUBLIC_IPFS_GATEWAY=http://ipfs_lamtek.paas.hcm-lab.id

# Public URL of this frontend (used for redirects/callbacks).
NEXT_PUBLIC_FRONTEND_URL=http://frontend_lamtek.paas.hcm-lab.id

# ---- Runtime-only (server side, NOT inlined) ----
# Target for the Next.js /api/* rewrite proxy. Reachable from the frontend
# CONTAINER (overlay service name), so keep it internal:
BACKEND_INTERNAL_URL=http://backend:3000
NODE_ENV=production
