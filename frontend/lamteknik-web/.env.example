# ============================================
# Frontend (Next.js) environment
# ============================================
# Copy to .env.local for local development:  cp .env.example .env.local
# NEXT_PUBLIC_* values are inlined at BUILD time, so rebuild after changing them.

# --- API base URL (must include the /api/v1 prefix) ---
# Local, backend run directly (next dev):     http://localhost:3000/api/v1
# Local, full docker-compose stack:           http://localhost:3001/api/v1
# PaaS / production:                          http://backend_lamtek.paas.hcm-lab.id/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Public URL of this frontend (redirects/callbacks) ---
# Local:  http://localhost:3002
# PaaS:   http://frontend_lamtek.paas.hcm-lab.id
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002

# --- IPFS gateway (monorepo backend/ipfs-cluster-private) ---
NEXT_PUBLIC_IPFS_GATEWAY=http://localhost:8080
