{
  "info": {
    "_postman_id": "a7c2d3e4-5f6a-7b8c-9d0e-lamteknik0003",
    "name": "LamTeknik Multi-Blockchain API",
    "description": "Besu, Go Ethereum, and Hyperledger Fabric are explicit gateway targets. Records never cross targets: Fabric calls the lamteknik-ledger chaincode, while Besu and Go Ethereum use their own EVM contracts. Select the LamTeknik (local multi-blockchain) environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": {"type": "text/javascript", "exec": [
      "const allDataRaw = pm.environment.get('allData') || '';",
      "pm.variables.set('allDataJson', JSON.stringify(allDataRaw));",
      "if (pm.request.method === 'POST' && /\"privateKey\":\\s*\"\"/.test(pm.request.body.raw || '')) {",
      "  pm.request.body.raw = pm.request.body.raw.replace(/,\\s*\"privateKey\":\\s*\"\"/, '');",
      "}"
    ]}
  }],
  "variable": [{"key": "txHash", "value": "", "type": "string"}],
  "item": [
    {
      "name": "Blockchain Besu",
      "item": [
        {"name": "Diagnostics", "item": [
          {"name": "GET Besu health", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/health"}},
          {"name": "GET Besu entities", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik"}},
          {"name": "GET Besu contracts", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/contracts"}}
        ]},
        {"name": "Entity", "item": [
          {"name": "GET Besu entity", "event": [{"listen": "test", "script": {"exec": ["pm.test(\"returns a decoded data array\", function () {", "  const body = pm.response.json();", "  pm.expect(body.success).to.eql(true);", "  pm.expect(body.data).to.be.an(\"array\");", "  if (body.data.length) pm.expect(body.data[0]).to.have.property(\"id\");", "});"]}}], "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}"}},
          {"name": "GET Besu entity count", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}/count"}},
          {"name": "POST Besu entity", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"recordId\": \"{{recordId}}\",\n  \"createdTimestamp\": {{createdTimestamp}},\n  \"modifiedTimestamp\": {{modifiedTimestamp}},\n  \"modifiedBy\": \"{{modifiedBy}}\",\n  \"allData\": {{allDataJson}},\n  \"privateKey\": \"{{privateKey}}\"\n}"}, "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}"}}
        ]}
      ]
    },
    {
      "name": "Blockchain Go Ethereum",
      "item": [
        {"name": "Diagnostics", "item": [
          {"name": "GET Go Ethereum health", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/health"}},
          {"name": "GET Go Ethereum entities", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik"}},
          {"name": "GET Go Ethereum contracts", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/contracts"}}
        ]},
        {"name": "Entity", "item": [
          {"name": "GET Go Ethereum entity", "event": [{"listen": "test", "script": {"exec": ["pm.test(\"returns a decoded data array\", function () {", "  const body = pm.response.json();", "  pm.expect(body.success).to.eql(true);", "  pm.expect(body.data).to.be.an(\"array\");", "  if (body.data.length) pm.expect(body.data[0]).to.have.property(\"id\");", "});"]}}], "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}"}},
          {"name": "GET Go Ethereum entity count", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}/count"}},
          {"name": "POST Go Ethereum entity", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"recordId\": \"{{recordId}}\",\n  \"createdTimestamp\": {{createdTimestamp}},\n  \"modifiedTimestamp\": {{modifiedTimestamp}},\n  \"modifiedBy\": \"{{modifiedBy}}\",\n  \"allData\": {{allDataJson}},\n  \"privateKey\": \"{{privateKey}}\"\n}"}, "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}"}}
        ]}
      ]
    },
    {
      "name": "Hyperledger Fabric",
      "item": [
        {"name": "Diagnostics", "item": [
          {"name": "GET Fabric health", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/health"}},
          {"name": "GET Fabric entities", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik"}},
          {"name": "GET Fabric chaincode", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/contracts"}}
        ]},
        {"name": "Entity", "item": [
          {"name": "GET Fabric entity", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}"}},
          {"name": "GET Fabric entity count", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}/count"}},
          {"name": "GET Fabric entity IDs", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}/ids"}},
          {"name": "GET Fabric record", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}/{{recordId}}"}},
          {"name": "GET Fabric record metadata", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}/{{recordId}}/metadata"}},
          {"name": "GET Fabric record exists", "request": {"method": "GET", "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}/{{recordId}}/exists"}},
          {"name": "POST Fabric entity", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"recordId\": \"{{recordId}}\",\n  \"createdTimestamp\": {{createdTimestamp}},\n  \"modifiedTimestamp\": {{modifiedTimestamp}},\n  \"modifiedBy\": \"{{modifiedBy}}\",\n  \"allData\": {{allDataJson}}\n}"}, "url": "{{baseUrl}}{{fabricPath}}/lamteknik/{{entity}}"}}
        ]}
      ]
    }
  ]
}
