# LAM Teknik SaaS API - PaaS Production Configuration
# ===================================================
# Copy this file and set appropriate values for your PaaS environment

# Node environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=lamtek_user
DB_PASSWORD=lamtek_password
DB_DATABASE=lamtek_dev
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=lamtek-backend-client
KAFKA_GROUP_ID=lamtek-consumer-group
KAFKA_CONSUMER_CLIENT_ID=lamtek-backend-consumer
KAFKA_CONSUMER_GROUP_ID=lamtek-consumer-runtime-group
DATA_FILE_WORKFLOW_MODE=kafka

# IPFS
IPFS_API_URL=http://ipfs:5001

# Blockchain (Besu)
BESU_RPC_URL=http://besu:8545
SIGNER_MODE=external
EXTERNAL_SIGNER_RPC_URL=http://web3signer:8545
EXTERNAL_SIGNER_ADDRESS=

# Vault (used when SIGNER_MODE=vault)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/lamtek/blockchain
VAULT_SECRET_KEY=privateKey

# Keep empty unless SIGNER_MODE=direct
BLOCKCHAIN_PRIVATE_KEY=

# JWT
JWT_SECRET=your-production-secret-key-change-this
JWT_EXPIRATION=3600

# CORS - Supports both local development and public/PaaS environments
# Format: comma-separated URLs for multiple domains
# Includes localhost for local development + production domain
# When localhost is detected, the backend automatically allows all origins for development
CORS_ORIGINS="localhost,http://localhost:3002,http://localhost:3000,http://localhost:3001,http://frontend_lamtek.paas.hcm-lab.id"

# Email Configuration (optional)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@example.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=noreply@lamtek.ac.id

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
