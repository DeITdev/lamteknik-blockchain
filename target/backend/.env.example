# LAM Teknik SaaS Blockchain Environment Configuration

# ===========================================
# Application Settings
# ===========================================
# PORT must stay 3000: the Dockerfile EXPOSE, docker-compose mapping (3001:3000),
# the frontend proxy target, and main.ts default all assume 3000.
NODE_ENV=development
PORT=3000
APP_NAME="LAM Teknik SaaS"
APP_VERSION=1.0.0

# CORS
# Add multiple origins separated by commas (no spaces after commas)
# The backend auto-detects 'localhost' and allows all origins for development
# For production: Replace with specific domain(s)
# Development: http://localhost:3002,http://localhost:3000,http://localhost:3001
# Production: http://frontend_lamtek.paas.hcm-lab.id,https://your-domain.com
CORS_ORIGINS="localhost,http://localhost:3002,http://localhost:3000,http://localhost:3001"
# Production example:
# CORS_ORIGINS="http://frontend_lamtek.paas.hcm-lab.id,http://admin.paas.hcm-lab.id"

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=mysql://lamtek:lamtek123@localhost:3307/lamtek_db
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=lamtek
DB_PASSWORD=lamtek123
DB_DATABASE=lamtek_db

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=lamtek-secret-key-2025-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Hyperledger Besu Configuration
# ===========================================
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546

# Signer Mode: external | vault | direct
SIGNER_MODE=external

# External signer (Web3Signer / EthSigner)
EXTERNAL_SIGNER_RPC_URL=http://localhost:8547
EXTERNAL_SIGNER_ADDRESS=

# Vault configuration (used when SIGNER_MODE=vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/lamtek/blockchain
VAULT_SECRET_KEY=privateKey

# Direct private key mode is allowed only when SIGNER_MODE=direct
BLOCKCHAIN_PRIVATE_KEY=

# Smart Contract Addresses (deploy contracts first)
AKREDITASI_CONTRACT_ADDRESS=
ASESMEN_KECUKUPAN_CONTRACT_ADDRESS=
ASESMEN_LAPANGAN_CONTRACT_ADDRESS=
DOKUMEN_IPFS_CONTRACT_ADDRESS=

# ===========================================
# Kafka Runtime Configuration
# ===========================================
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=lamtek-backend
KAFKA_GROUP_ID=lamtek-consumer-group
KAFKA_CONSUMER_CLIENT_ID=lamtek-backend-consumer
KAFKA_CONSUMER_GROUP_ID=lamtek-consumer-runtime-group

# Data file workflow mode: sync | kafka
DATA_FILE_WORKFLOW_MODE=sync

# ===========================================
# IPFS Configuration
# ===========================================
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# ===========================================
# File Upload Settings
# ===========================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ===========================================
# Rate Limiting
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
