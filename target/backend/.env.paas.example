# ============================================================
# SERVICE 3 — BACKEND (NestJS api-gateway)
# Build context: ./backend   |   Listens internally on :3000
# ============================================================
# This is the hub: it talks to blockchain, kafka, mysql, redis, ipfs.
# Every value below is read via ConfigService — NOTHING is hardcoded in code,
# so these env vars are the single source of truth.
#
# Hostnames assume a SHARED Docker Swarm overlay network where each service is
# reachable by its service name (blockchain, kafka, mysql, redis, ipfs).
# If a dependency is a managed PaaS add-on or a public host, just swap the host.

NODE_ENV=production
PORT=3000
APP_NAME=LAM Teknik SaaS
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_FORMAT=combined

# ---- CORS: list the PUBLIC frontend origin(s), comma-separated, NO spaces ----
# Must NOT contain "localhost" in production or the backend falls back to "*".
CORS_ORIGINS=http://frontend_lamtek.paas.hcm-lab.id

# ============================================================
# Database (MySQL)
# ============================================================
DATABASE_URL=mysql://lamtek:lamtek123@mysql:3306/lamtek_db
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=lamtek
DB_PASSWORD=lamtek123
DB_DATABASE=lamtek_db
SEED_ON_STARTUP=true
# Skema dibangun oleh MIGRATION (docker-start.sh -> `npm run migration:run`),
# bukan synchronize. Migration lengkap = src/database/migrations/*CompleteSchema*
# (39 tabel, sudah diuji + seed jalan). Biarkan false agar app tidak meng-sync
# ulang di atas skema migrasi.
TYPEORM_SYNCHRONIZE=false

# ============================================================
# Redis  (OPSIONAL — backend saat ini TIDAK membaca REDIS_URL / tak memakai Redis.
# Aman dihapus dari stack; dibiarkan untuk kompatibilitas ke depan.)
# ============================================================
REDIS_URL=redis://redis:6379

# ============================================================
# JWT  (CHANGE THIS SECRET IN PRODUCTION)
# ============================================================
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Blockchain (Hyperledger / Hardhat node — SERVICE 1)
# ============================================================
BESU_RPC_URL=http://blockchain:8545
BESU_WS_URL=ws://blockchain:8546

# Hardhat exposes unlocked accounts, so the node signs for us.
SIGNER_MODE=external
EXTERNAL_SIGNER_RPC_URL=http://blockchain:8545
# Empty = use account #0 (the deployer) as signer.
EXTERNAL_SIGNER_ADDRESS=

# Vault is NOT used in this setup (SIGNER_MODE=external). Leave blank.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/lamtek/blockchain
VAULT_SECRET_KEY=privateKey
BLOCKCHAIN_PRIVATE_KEY=

# ---- Smart contract addresses (deterministic from blockchain deploy.js) ----
AKREDITASI_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ASESMEN_KECUKUPAN_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ASESMEN_LAPANGAN_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
DOKUMEN_IPFS_CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# ============================================================
# Kafka (SERVICE 2)
# ============================================================
# Use the broker host that matches Kafka's KAFKA_ADVERTISED_LISTENERS.
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=lamtek-backend
KAFKA_GROUP_ID=lamtek-consumer-group
KAFKA_CONSUMER_CLIENT_ID=lamtek-backend-consumer
KAFKA_CONSUMER_GROUP_ID=lamtek-consumer-runtime-group
# sync | kafka  — set "kafka" to route the data-file workflow through Kafka.
DATA_FILE_WORKFLOW_MODE=kafka

# ============================================================
# IPFS  (digabung ke dalam service "blockchain" — 1 container)
# ============================================================
# API dipakai backend (server-side); gateway untuk ambil file.
IPFS_API_URL=http://blockchain:5001
IPFS_GATEWAY_URL=http://blockchain:8080

# ============================================================
# Uploads / Rate limiting
# ============================================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
THROTTLE_TTL=60
THROTTLE_LIMIT=100
