# Copy this file to .env before starting the Fabric Compose stack.
# Set EXPLORER_BIND_ADDRESS to the VM's private IP to expose Explorer remotely.
EXPLORER_CONFIG_FILE_PATH=./explorer/config.json
EXPLORER_PROFILE_DIR_PATH=./explorer/runtime-connection-profile
FABRIC_CRYPTO_PATH=./explorer/organizations
EXPLORER_BIND_ADDRESS=127.0.0.1
EXPLORER_PORT=8091
