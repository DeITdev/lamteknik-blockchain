# LamTeknik API Gateway
LAMTEKNIK_PORT=4100

# Blockchain target configuration. Legacy BLOCKCHAIN_* values remain Besu aliases.
GETH_RPC_URL=http://127.0.0.1:8555
GETH_CHAIN_ID=1337

# Backward-compatible Besu aliases
BLOCKCHAIN_RPC_URL=http://localhost:8545
BESU_RPC_URL=http://localhost:8545
CHAIN_ID=1337
BESU_CHAIN_ID=1337

# Gateway signer — signs CDC and researcher writes (never share with researchers)
DEPLOYER_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
DEFAULT_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
DEFAULT_ADDRESS=0xfe3b557e8fb62b89f4916b721be55ceb828dbd73

# Besu can use a dedicated key; Go Ethereum uses its local node-managed dev account.
BESU_DEPLOYER_PRIVATE_KEY=

# IPFS proxy targets (VM .40 in production)
IPFS_CLUSTER_REST_URL=http://127.0.0.1:9094
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Auth — set API_KEY_REQUIRED=false for local dev without keys
API_KEY_REQUIRED=false
API_KEYS_FILE=./keys.json

# Optional audit log (BAF pattern)
AUDIT_LOG_ENABLED=false

# CORS Configuration
CORS_ORIGIN=*

# Hardhat deploy filters (used by POST /deploy/lamteknik)
# LAMTEKNIK_ONLY=AkreditasiStorage,UserStorage
