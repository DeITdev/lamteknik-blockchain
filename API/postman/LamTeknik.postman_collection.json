{
  "info": {
    "_postman_id": "a7c2d3e4-5f6a-7b8c-9d0e-lamteknik0003",
    "name": "LamTeknik Multi-Blockchain API",
    "description": "Besu and Go Ethereum are explicit gateway targets. Contracts and records never cross targets, even though both local development chains use chain ID 1337. Select the LamTeknik (local multi-blockchain) environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": {"type": "text/javascript", "exec": [
      "const allDataRaw = pm.environment.get('allData') || '';",
      "pm.variables.set('allDataJson', JSON.stringify(allDataRaw));",
      "if (pm.request.method === 'POST' && /\"privateKey\":\\s*\"\"/.test(pm.request.body.raw || '')) {",
      "  pm.request.body.raw = pm.request.body.raw.replace(/,\\s*\"privateKey\":\\s*\"\"/, '');",
      "}"
    ]}
  }],
  "variable": [{"key": "txHash", "value": "", "type": "string"}],
  "item": [
    {
      "name": "Blockchain Besu",
      "item": [
        {"name": "Diagnostics", "item": [
          {"name": "GET Besu health", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/health"}},
          {"name": "GET Besu entities", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik"}},
          {"name": "GET Besu contracts", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/contracts"}}
        ]},
        {"name": "Entity", "item": [
          {"name": "GET Besu entity", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}"}},
          {"name": "GET Besu entity count", "request": {"method": "GET", "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}/count"}},
          {"name": "POST Besu entity", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"recordId\": \"{{recordId}}\",\n  \"createdTimestamp\": {{createdTimestamp}},\n  \"modifiedTimestamp\": {{modifiedTimestamp}},\n  \"modifiedBy\": \"{{modifiedBy}}\",\n  \"allData\": {{allDataJson}},\n  \"privateKey\": \"{{privateKey}}\"\n}"}, "url": "{{baseUrl}}{{besuPath}}/lamteknik/{{entity}}"}}
        ]}
      ]
    },
    {
      "name": "Blockchain Go Ethereum",
      "item": [
        {"name": "Diagnostics", "item": [
          {"name": "GET Go Ethereum health", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/health"}},
          {"name": "GET Go Ethereum entities", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik"}},
          {"name": "GET Go Ethereum contracts", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/contracts"}}
        ]},
        {"name": "Entity", "item": [
          {"name": "GET Go Ethereum entity", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}"}},
          {"name": "GET Go Ethereum entity count", "request": {"method": "GET", "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}/count"}},
          {"name": "POST Go Ethereum entity", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"recordId\": \"{{recordId}}\",\n  \"createdTimestamp\": {{createdTimestamp}},\n  \"modifiedTimestamp\": {{modifiedTimestamp}},\n  \"modifiedBy\": \"{{modifiedBy}}\",\n  \"allData\": {{allDataJson}},\n  \"privateKey\": \"{{privateKey}}\"\n}"}, "url": "{{baseUrl}}{{gethPath}}/lamteknik/{{entity}}"}}
        ]}
      ]
    }
  ]
}
